#!/bin/bash
# Install only on the independent observer host. Stage first, enable explicitly later.
set -euo pipefail
[[ $EUID == 0 && $(uname -s) == Linux ]] || exit 1
ops=$(cd -- "$(dirname -- "$0")" && pwd)
if systemctl is-active --quiet hermes-gateway.service; then
    echo "Use an independent observer host, not the running primary." >&2
    exit 1
fi
install -d -m 0700 /etc/psy-observer
install -d -m 0755 /usr/local/libexec
if [[ ! -e /etc/psy-observer/instance.env ]]; then
    install -m 0600 "$ops/observer/instance.env.example" /etc/psy-observer/instance.env
fi
install -m 0644 "$ops/libexec/psy_alerts.py" /usr/local/libexec/psy-alerts.py
install -m 0644 "$ops/observer/psy-alerts.service" /etc/systemd/system/psy-alerts.service
install -m 0644 "$ops/systemd/psy-alerts.timer" /etc/systemd/system/psy-alerts.timer
systemctl daemon-reload
echo "Observer staged, not started. Set owner, HTTPS origin and hidden credential before enabling."
