[Unit]
Description=Private offline recording recognizer for PSY
Before=psy-upload-worker.service
[Service]
Type=simple
User=psy-asr
Group=psy-deliver
RuntimeDirectory=psy-asr
RuntimeDirectoryMode=0750
StateDirectory=psy-asr
StateDirectoryMode=0700
Environment=HOME=/var/lib/psy-asr HERMES_HOME=/var/lib/psy-asr PSY_ASR_STANDALONE=1 PSY_ASR_INPUT=/srv/psy-media PSY_ASR_OUTPUT=/var/lib/psy-asr/export PSY_ASR_PROGRESS=/var/lib/psy-asr/progress PSY_WHISPER_MODEL=/opt/psy-asr-model HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
ExecStart=/opt/psy-asr-venv/bin/python -I /opt/psy-upload/asr_service.py
Restart=on-failure
RestartSec=5
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
BindReadOnlyPaths=/home/hermes/.hermes/media-vault/uploads:/srv/psy-media
InaccessiblePaths=/etc/psy-upload
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
Nice=5
CPUWeight=50
MemoryHigh=550M
MemoryMax=700M
MemorySwapMax=1000M
TasksMax=96
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
