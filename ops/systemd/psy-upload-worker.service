[Unit]
Description=PSY durable local recording transcription queue
Wants=network-online.target
After=network-online.target psy-asr.service
Wants=psy-asr.service
[Service]
EnvironmentFile=/etc/psy/instance.env
Type=simple
User=psy-deliver
Group=psy-deliver
Environment=HOME=/nonexistent HERMES_HOME=/nonexistent PSY_UPLOAD_ROOT=/srv/psy-queue PSY_UPLOAD_FILES=/srv/psy-media PSY_ASR_PROGRESS=/srv/psy-progress PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WorkingDirectory=/opt/psy-upload
ExecStart=/opt/psy-upload-venv/bin/python /opt/psy-upload/worker.py
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
LoadCredential=telegram:/etc/psy-upload/telegram
BindPaths=/home/hermes/.hermes/vault/uploads:/srv/psy-queue /home/hermes/.hermes/media-vault/uploads:/srv/psy-media
BindReadOnlyPaths=/var/lib/psy-asr/progress:/srv/psy-progress
ReadWritePaths=/srv/psy-queue /srv/psy-media
InaccessiblePaths=/etc/psy-upload
PrivateTmp=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
Nice=5
CPUWeight=100
MemoryHigh=100M
MemoryMax=180M
MemorySwapMax=1000M
TasksMax=128
[Install]
WantedBy=multi-user.target
