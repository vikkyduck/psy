[Unit]
Description=PSY durable local recording transcription queue
Wants=network-online.target
After=network-online.target psy-asr.service
Wants=psy-asr.service
[Service]
LoadCredential=recording-signing:/etc/psy-upload/recording-signing
EnvironmentFile=/etc/psy/instance.env
Type=simple
User=psy-deliver
Group=psy-deliver
Environment=HOME=/nonexistent HERMES_HOME=/nonexistent PSY_UPLOAD_ROOT=/srv/psy-queue PSY_UPLOAD_FILES=/srv/psy-media PSY_ASR_PROGRESS=/srv/psy-progress PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WorkingDirectory=/opt/psy-upload
ExecStart=/opt/psy-upload-venv/bin/python /opt/psy-upload/worker.py
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
LoadCredential=telegram:/etc/psy-upload/telegram
BindPaths=/home/hermes/.hermes/vault/uploads:/srv/psy-queue /home/hermes/.hermes/media-vault/uploads:/srv/psy-media
BindReadOnlyPaths=/var/lib/psy-asr/progress:/srv/psy-progress
ReadWritePaths=/srv/psy-queue /var/lib/psy-recording-receipts
InaccessiblePaths=/etc/psy-upload
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
# HTTPS to Telegram and the ASR socket. Netlink lets glibc answer AI_ADDRCONFIG lookups.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=true
Nice=5
CPUWeight=100
MemoryHigh=100M
MemoryMax=180M
MemorySwapMax=1000M
TasksMax=128
[Install]
WantedBy=multi-user.target
