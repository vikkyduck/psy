[Unit]
Description=Issue one group recording ticket to the gateway
[Service]
LoadCredential=recording-signing:/etc/psy-upload/recording-signing
EnvironmentFile=/etc/psy/instance.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/psy-group/upload_broker.py
StandardInput=socket
StandardOutput=null
User=psy-deliver
Group=psy-deliver
UMask=0077
ProtectHome=yes
ProtectSystem=strict
BindPaths=/home/hermes/.hermes/vault/uploads:/srv/psy-queue
ReadWritePaths=/srv/psy-queue
InaccessiblePaths=/etc/psy-upload /var/lib/psy-asr
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectControlGroups=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=yes
MemoryMax=64M
RuntimeMaxSec=15
