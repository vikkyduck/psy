[Unit]
Description=Archive PSY generated results to its private local vault

[Service]
Type=oneshot
User=hermes
Group=hermes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/psy-vault-archive.py
UMask=0077
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes/vault
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# The first run after an upgrade hashes every generated file once to fill the cache.
TimeoutStartSec=10min
