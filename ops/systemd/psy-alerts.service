[Unit]
Description=PSY independent owner alerts
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/psy/instance.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/psy-alerts.py
TimeoutStartSec=120
StateDirectory=psy-alerts
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/psy-alerts
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
