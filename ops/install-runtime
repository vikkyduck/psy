#!/bin/bash
# Stage first-party sources on an idle host. Activation is a separate operator action.
set -euo pipefail
[[ $EUID == 0 && $(uname -s) == Linux ]] || exit 1
case "${1:-}" in ''|--new-profile) ;; *) exit 2 ;; esac
repo=$(cd -- "$(dirname -- "$0")/.." && pwd)
ops=$repo/ops
for unit in hermes-gateway.service psy-upload.service psy-upload-worker.service psy-asr.service \
    psy-member.socket psy-group-upload.socket psy-healthcheck.timer psy-codex-auth.timer \
    psy-upload-cert-renew.timer psy-upload-health.timer psy-vault-archive.timer psy-alerts.timer psy-backup.timer; do
    if systemctl is-active --quiet "$unit"; then
        echo "$unit active. Stage this restore on an idle host." >&2; exit 1
    fi
done
cd /
test -d /etc/psy
test -f "$repo/media/transcribe.py"
test -f "$repo/media/audio-transcription-SKILL.md"
test -f "$repo/profile/SOUL.md"
test -f "$repo/gateway/group-manifest.json"
install -d -m 0755 /usr/local/libexec /usr/local/lib/psy-group /opt/psy-upload /opt/psy-upload/static
for file in access_broker asr_client asr_sandbox asr_service psy_upload_common queue_health recording_grant recording_receipts server storage_capacity transcribe worker; do
    install -m 0644 "$repo/media/$file.py" /opt/psy-upload/
done
install -m 0644 "$repo/media/static/"* /opt/psy-upload/static/
install -m 0644 "$repo/gateway/upload_broker.py" "$ops/libexec/preflight.py" /usr/local/lib/psy-group/
install -m 0644 "$repo/gateway/group-manifest.json" /usr/local/lib/psy-group/manifest.json
install -m 0644 "$ops/libexec/psy_codex_auth.py" /usr/local/libexec/psy-codex-auth.py
install -m 0644 "$ops/libexec/psy_healthcheck.py" /usr/local/libexec/psy-healthcheck.py
install -m 0644 "$ops/libexec/psy_alerts.py" /usr/local/libexec/psy-alerts.py
install -m 0644 "$ops/libexec/psy_vault_archive.py" /usr/local/libexec/psy-vault-archive.py
install -m 0644 "$ops/libexec/upload_healthcheck.py" /usr/local/libexec/psy-upload-healthcheck.py
install -m 0755 "$ops/libexec/deploy-cert" /usr/local/libexec/psy-upload-deploy-cert
# Audio priority only controlled an optional build. Its timer is disabled on the reference host.
for file in "$ops/systemd/"*.service "$ops/systemd/"*.socket "$ops/systemd/"*.timer; do
    case "$file" in */psy-audio-priority.*|*/psy-backup.*) continue ;; esac
    install -m 0644 "$file" /etc/systemd/system/
done
install -d -m 0755 /etc/systemd/system/hermes-gateway.service.d
install -m 0644 "$ops/systemd/hermes-gateway.service.d/"*.conf /etc/systemd/system/hermes-gateway.service.d/
# Resolve the user@ unit from the new Linux UID. Reference host UID allocation is not portable.
printf '[Unit]\nAfter=user@%s.service\nWants=user@%s.service\n' "$(id -u hermes)" "$(id -u hermes)" \
    > /etc/systemd/system/hermes-gateway.service.d/user-session.conf
for unit in hermes-gateway psy-healthcheck psy-upload-health psy-codex-auth psy-upload-cert-renew psy-upload psy-upload-worker psy-asr; do
    install -d -m 0755 "/etc/systemd/system/$unit.service.d"
    printf '[Unit]\nOnFailure=psy-alerts.service\n' > "/etc/systemd/system/$unit.service.d/owner-alert.conf"
done
h=/home/hermes/.hermes
skill=$h/skills/media/audio-transcription
# Root reads trusted release files. All writes in the owner's home happen under the owner's UID.
runuser -u hermes -- mkdir -p -m 0700 "$skill/scripts"
for spec in "media/audio-transcription-SKILL.md:$skill/SKILL.md" "media/transcribe.py:$skill/scripts/transcribe.py"; do
    runuser -u hermes -- sh -ec 'umask 077; t=$(mktemp -- "$1.tmp.XXXXXXXX"); cat > "$t"; chmod 0600 "$t"; mv -Tf -- "$t" "$1"' sh "${spec#*:}" < "$repo/${spec%%:*}"
done
if [[ ${1:-} == --new-profile ]] && runuser -u hermes -- test -f "$h/SOUL.md" && ! runuser -u hermes -- cat "$h/SOUL.md" | cmp -s - "$repo/profile/SOUL.md"; then
    runuser -u hermes -- sh -ec 'test ! -e "$1.before-psy"; mv -T "$1" "$1.before-psy"; chmod 0600 "$1.before-psy"' sh "$h/SOUL.md"
fi
if ! runuser -u hermes -- test -e "$h/SOUL.md"; then
    runuser -u hermes -- sh -ec 'umask 077; set -C; cat > "$1"' sh "$h/SOUL.md" < "$repo/profile/SOUL.md"
fi
systemctl daemon-reload
echo "Runtime staged. Units have not been started or enabled."
