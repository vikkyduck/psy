# Instance identifiers only. Telegram and OAuth credentials have separate private files.
# Fill in every required field on the target host.
PSY_OWNER_ID=
PSY_GROUP_ID=
PSY_BOT_ID=
PSY_BOT_USERNAME=
PSY_PUBLIC_URL=https://recordings.example.invalid:9443
# With direct TLS, the listener port must match the origin's port.
PSY_LISTEN_HOST=0.0.0.0
PSY_LISTEN_PORT=9443
