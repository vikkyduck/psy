#!/bin/bash
# Extract the already validated Telegram credential as the profile owner.
set -euo pipefail
[[ $EUID == 0 ]] || exit 1
umask 077
cd /
dir=/etc/psy-upload
tmp=$(mktemp -- "$dir/.credential.XXXXXXXX")
trap 'rm -f -- "$tmp"' EXIT
runuser -u hermes -- /opt/psy-upload-venv/bin/python -I - <<'PY' > "$tmp"
from dotenv import dotenv_values
from pathlib import Path
import re
import sys
instance = dotenv_values('/etc/psy/instance.env', interpolate=False)
token = dotenv_values(Path('/home/hermes/.hermes/.env'), interpolate=False).get('TELEGRAM_BOT_TOKEN') or ''
if not re.fullmatch('[0-9]+:[a-zA-Z0-9_-]{30,}', token) or token.partition(':')[0] != instance['PSY_BOT_ID']:
    sys.exit('Missing or mismatched Telegram credential')
sys.stdout.write(token)
PY
mv -fT -- "$tmp" "$dir/telegram"
echo "Root-only systemd credential staged"
