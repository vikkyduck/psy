#!/bin/bash
# Extract the already validated Telegram credential as the profile owner.
set -euo pipefail
[[ $EUID == 0 ]] || exit 1
umask 077
ops=$(cd -- "$(dirname -- "$0")" && pwd)
cd /
bot=$(python3 -I "$ops/instance_env.py" get PSY_BOT_ID /etc/psy/instance.env)
[[ $bot =~ ^[1-9][0-9]*$ ]] || { echo "Set PSY_BOT_ID in /etc/psy/instance.env" >&2; exit 1; }
dir=/etc/psy-upload
tmp=$(mktemp -- "$dir/.credential.XXXXXXXX")
trap 'rm -f -- "$tmp"' EXIT
runuser -u hermes -- /opt/psy-upload-venv/bin/python -I - "$bot" <<'PY' > "$tmp"
from dotenv import dotenv_values
from pathlib import Path
import re
import sys
token = dotenv_values(Path('/home/hermes/.hermes/.env'), interpolate=False).get('TELEGRAM_BOT_TOKEN') or ''
if not re.fullmatch('[0-9]+:[a-zA-Z0-9_-]{30,}', token) or token.partition(':')[0] != sys.argv[1]:
    sys.exit('Missing or mismatched Telegram credential')
sys.stdout.write(token)
PY
mv -fT -- "$tmp" "$dir/telegram"
echo "Root-only systemd credential staged"
