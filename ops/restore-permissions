#!/bin/bash
# Rebuild named ownership and ACLs after regular-file recovery, only on an idle host.
set -euo pipefail
[[ $EUID == 0 && $(uname -s) == Linux ]] || exit 1
ops=$(cd -- "$(dirname -- "$0")" && pwd)
units=$(python3 -I "$ops/inventory.py" idle)
for unit in $units; do
    state=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
    case "$state" in active|activating|deactivating|reloading)
        echo "Recovery requires idle services and disabled timers" >&2; exit 1 ;;
    esac
done
h=/home/hermes/.hermes
[[ -d $h && ! -L $h && $(getent passwd hermes | cut -d: -f6) == /home/hermes ]]
# The verifier never restores links. Refuse links in state rather than chowning a target.
for tree in "$h/vault" "$h/media-vault" "$h/psy-owner-recovery" "$h/psy-codex-renewals" /var/lib/psy-asr; do
    if [[ -d $tree ]] && [[ -n $(find "$tree" -type l -print -quit) ]]; then
        echo "Unexpected link in recovered private state" >&2; exit 1
    fi
done
chown hermes:hermes /home/hermes
# Do not dereference environment symlinks. All profile state, including pending OAuth journals, belongs to hermes.
chown -hR hermes:hermes "$h"
chmod 0700 /home/hermes "$h"
for tree in "$h/vault" "$h/media-vault" "$h/psy-owner-recovery" "$h/psy-codex-renewals"; do
    [[ -d $tree ]] || continue
    chown -R hermes:hermes "$tree"
    setfacl -R -b -k "$tree"
    find "$tree" -type d -exec chmod 0700 {} +
    find "$tree" -type f -exec chmod 0600 {} +
done
find "$h" -maxdepth 1 -type f -exec chmod go-rwx {} +
for name in .env auth.json config.yaml SOUL.md state.db psy-codex-received.json; do
    p=$h/$name
    [[ ! -L $p ]]
    if [[ -f $p ]]; then chown hermes:hermes "$p"; chmod 0600 "$p"; fi
done
# Shared directories: the same policy prepare-host applies (ops/acl-policy.sh), plus the
# recovered entries inside them.
. "$ops/acl-policy.sh"
q=$h/vault/uploads
m=$h/media-vault/uploads
[[ -d $q && -d $m ]]
for shared in "$q:QUEUE" "$m:MEDIA"; do
    psy_shared_acl_entries "${shared%:*}" "${shared##*:}"
    psy_shared_acl "${shared%:*}" "${shared##*:}"
done
receipt=/var/lib/psy-recording-receipts
[[ -d $receipt && ! -L $receipt ]]
chown psy-deliver:psy-upload "$receipt"
chmod 0750 "$receipt"
if [[ -f $receipt/results.sqlite3 ]]; then
    [[ ! -L $receipt/results.sqlite3 ]]
    chown psy-deliver:psy-upload "$receipt/results.sqlite3"
    chmod 0640 "$receipt/results.sqlite3"
fi
if [[ -d /var/lib/psy-asr ]]; then
    chown -R psy-asr:psy-deliver /var/lib/psy-asr
    find /var/lib/psy-asr -type d -exec chmod 0700 {} +
    find /var/lib/psy-asr -type f -exec chmod 0600 {} +
    progress=/var/lib/psy-asr/progress
    install -d -m 0750 -o psy-asr -g psy-deliver "$progress"
    psy_shared_acl_entries "$progress" PROGRESS
    psy_shared_acl "$progress" PROGRESS
fi
if [[ -f /etc/psy-upload/recording-signing ]]; then
    [[ ! -L /etc/psy-upload/recording-signing ]]
    chown root:root /etc/psy-upload/recording-signing
    chmod 0600 /etc/psy-upload/recording-signing
fi
echo "Recovered state ownership and ACLs rebuilt by account name. No service started."
