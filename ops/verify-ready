#!/bin/bash
# Verify prerequisites without network access, refreshing a grant or starting a unit.
set -euo pipefail
[[ $EUID == 0 ]] || exit 1
ops=$(cd -- "$(dirname -- "$0")" && pwd)
repo=$(cd "$ops/.." && pwd)
h=/home/hermes/.hermes
checkout=$h/hermes-agent
cd /
bash "$ops/test-host" --units
runuser -u hermes -- python3 -I /usr/local/lib/psy-group/preflight.py
runuser -u hermes -- test -x "$checkout/.hermes/bin/hermes"
for path in "$h/.env" "$h/config.yaml" "$h/auth.json"; do
    [[ $(runuser -u hermes -- stat -Lc '%a %U' "$path") == '600 hermes' ]]
done
[[ $(stat -c '%a %U' /etc/psy-upload/telegram) == '600 root' ]]
runuser -u hermes -- bash -ec 'set -a; . /etc/psy/instance.env; set +a; cd "$1"
    /usr/bin/python3 -c "import hermes_bootstrap; import faster_whisper, telegram; import plugins.platforms.telegram.psy_instance"
    /usr/bin/python3 -c "import sys; sys.path.insert(0, \"/opt/psy-upload\"); import psy_upload_common"' bash "$checkout"
runuser -u psy-asr -- /opt/psy-asr-venv/bin/python -I -c 'from faster_whisper import WhisperModel'
/opt/psy-upload-venv/bin/python -I -c 'import aiohttp, certbot, dotenv'
(cd /opt/psy-asr-model && sha256sum --quiet --check "$repo/media/model.sha256")
runuser -u psy-upload -- python3 -I -c 'from ssl import SSLContext, PROTOCOL_TLS_SERVER
from pathlib import Path
d=Path("/etc/psy-upload/tls/current"); SSLContext(PROTOCOL_TLS_SERVER).load_cert_chain(d/"fullchain.pem", d/"privkey.pem")'
echo "PASS: local gateway, model, Python imports, private identity files and TLS pair ready"
