+def _refresh_pool_codex_row(row: dict[str, Any], *, force_refresh: bool,
+                            skew: Optional[int]) -> Optional[tuple[str, str]]:
+    from agent.credential_pool import load_pool
+    from hermes_cli.auth import read_credential_pool
+
+    with _codex_pool_owner_lock():
+        managed = _renew_psy_codex(row)
+        if managed is not None:
+            return managed["access_token"], _stripped(managed.get("base_url"))
+        if not row.get("id"):
+            # Old stores have no row id. Only a unique, unchanged bearer can identify that row.
+            token = row["access_token"]
+            matches = [e for e in _codex_pool_dicts(read_credential_pool("openai-codex"))
+                       if e.get("access_token") == token]
+            if len(matches) != 1 or matches[0] != row:
+                return None
+            refreshed = load_pool("openai-codex").try_refresh_matching(api_key_hint=token)
+            if refreshed is None:
+                return None
+            return refreshed.runtime_api_key, _stripped(row.get("base_url"))
+        pool = load_pool("openai-codex")
+        entry = next((e for e in pool.entries() if e.id == row["id"]), None)
+        if entry is None or entry.auth_type != "oauth" or not _codex_pool_row_available(entry.to_dict(), pool._is_sole_credential()):
+            return None
+        # Another process may already have replaced the bearer that triggered the 401 or expiry.
+        needs_forced = force_refresh and entry.access_token == row.get("access_token")
+        if needs_forced or _codex_access_token_is_expiring(entry.access_token, skew or 0):
+            entry = pool.try_refresh_matching(credential_id=entry.id)
+            if entry is None:
+                return None
+        return entry.runtime_api_key, _stripped(entry.base_url)
+
